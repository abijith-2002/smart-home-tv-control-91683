<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        
        <!-- Material3 Switch colors -->
        <item name="colorControlActivated">@color/switch_on_bg</item>
        <item name="colorSwitchThumbNormal">@color/switch_handle_off</item>
    </style>
    
    <!-- Typography styles using Figtree font with 7% reduction -->
    <style name="TextAppearance.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <style name="TextAppearance.Header" parent="TextAppearance.AppCompat">
        <item name="android:textSize">29sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <style name="TextAppearance.DeviceName" parent="TextAppearance.AppCompat">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <style name="TextAppearance.Switch" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <style name="TextAppearance.CountBadge" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="android:letterSpacing">0</item>
    </style>
    
    <!-- Component styles -->
    <style name="SidebarIconStyle">
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="android:padding">@dimen/icon_padding</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/sidebar_item_bg</item>
    </style>

    <!-- TV-optimized sidebar icon style with subtle pill background on focus + tint selector -->
    <style name="SidebarIconStyleTv">
        <item name="android:layout_width">@dimen/sidebar_icon_touch_target</item>
        <item name="android:layout_height">@dimen/sidebar_icon_touch_target</item>
        <item name="android:padding">@dimen/sidebar_icon_padding</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <!-- Subtle rounded pill appears only on focus; unchanged -->
        <item name="android:background">@drawable/sidebar_focus_pill</item>
        <!-- Icon tint changes with focus; unchanged -->
        <item name="android:tint">@drawable/sidebar_icon_tint_selector</item>
        <item name="tint">@drawable/sidebar_icon_tint_selector</item>
        <!-- Remove default ripples for TV to avoid visual noise -->
        <item name="android:foreground">@null</item>
    </style>
    
    <style name="DeviceCardStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/device_card_height</item>
        <item name="android:layout_margin">@dimen/device_card_margin</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>
    
    <!-- Custom MaterialSwitch Style with specific colors and border -->
    <style name="CustomMaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="useMaterialThemeColors">false</item>
        <item name="trackTint">@drawable/switch_track_selector</item>
        <item name="thumbTint">@drawable/switch_thumb_selector</item>
        <item name="android:background">@drawable/switch_track_border</item>
    </style>
    <!-- Rounded Material3 Button style for compact TV header buttons -->
    <style name="RoundedHeaderButton" parent="Widget.Material3.Button">
        <!-- Typography -->
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <!-- Heavier weight for better legibility on TV (+ label) -->
        <item name="android:textStyle">bold</item>
        <!-- Slightly larger text size for visibility -->
        <item name="android:textSize">18sp</item>

        <!-- Shape and spacing -->
        <item name="cornerRadius">24dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>

        <!-- Colors to match design -->
        <item name="backgroundTint">@color/add_button_bg</item>
        <!-- Ensure readable text color on #ABC7FF background -->
        <item name="android:textColor">@color/text</item>

        <!-- TV focus visual consistency (uses Material defaults augmented by our background) -->
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
