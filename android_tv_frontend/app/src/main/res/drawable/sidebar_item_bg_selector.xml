<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: outline (stroke only), no solid fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/focus_color" />
        </shape>
    </item>

    <!-- Pressed: same as focused on TV -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/focus_color" />
        </shape>
    </item>

    <!-- DEBUG: transparent by default with a faint green alpha to detect if this layer is showing (will remove later) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#0018FF00" />
        </shape>
    </item>
</selector>
