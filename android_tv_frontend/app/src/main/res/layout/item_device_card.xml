<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/device_card_height"
    android:layout_margin="@dimen/device_card_margin"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/card_padding">

        <!-- Device Icon -->
        <FrameLayout
            android:id="@+id/device_icon_container"
            android:layout_width="@dimen/device_icon_size"
            android:layout_height="@dimen/device_icon_size"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/device_icon_start_margin"
            android:layout_marginBottom="@dimen/device_icon_bottom_margin"
            android:background="@color/surface">

            <ImageView
                android:id="@+id/device_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:contentDescription="Device Icon"
                android:padding="@dimen/device_icon_padding"
                app:srcCompat="@drawable/lightbulb_24" />
        </FrameLayout>

        <!-- Device Name and Switch Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/device_name_top_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Name"
                android:textAppearance="@style/TextAppearance.DeviceName" />

            <!-- Material3 Switch without text labels -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/device_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/switch_width"
                android:minHeight="@dimen/switch_height"
                android:background="@null"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:showText="false"
                android:text=""
                app:useMaterialThemeColors="true"
                app:thumbTint="@color/switch_handle_on"
                app:trackTint="@color/card_on_bg" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
