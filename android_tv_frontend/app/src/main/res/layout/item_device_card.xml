<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/device_card_height"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    android:clipToOutline="false"
    app:cardUseCompatPadding="true"
    app:cardPreventCornerOverlap="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/card_padding">

        <!-- Device Icon -->
        <FrameLayout
            android:id="@+id/device_icon_container"
            android:layout_width="@dimen/device_icon_size"
            android:layout_height="@dimen/device_icon_size"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/device_icon_start_margin"
            android:layout_marginBottom="@dimen/device_icon_bottom_margin"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/device_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:adjustViewBounds="true"
                android:contentDescription="Device Icon"
                android:padding="@dimen/device_icon_padding"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/lightbulb_24" />
        </FrameLayout>

        <!-- Device Name and Switch Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/device_name_top_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/device_icon_text_spacing"
                android:text="Device Name"
                android:textAppearance="@style/TextAppearance.DeviceName" />

            <!-- Material3 Switch with custom colors and 2dp border -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/device_switch"
                style="@style/CustomMaterialSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/switch_width"
                android:minHeight="@dimen/switch_height"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:showText="false"
                android:text="" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
